# Copy this file to ".env" (same folder) and edit. NEVER commit ".env" and never put these values in frontend code.

# ---- general -------------------------------------------------------------------------------------
APP_ENV=development                 # development | production | test
LOG_LEVEL=INFO
# Signs login tokens. In development a random key is created automatically (storage/.secret_key).
# In production you MUST set one:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=480

# ---- web ----------------------------------------------------------------------------------------------
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
ALLOW_REGISTRATION=true             # set false once your accounts exist
FRAME_ANCESTORS=                    # e.g. 'none' in production to forbid embedding the app in other sites

# ---- storage (defaults are fine) ----------------------------------------------------------------------------
# DATABASE_URL=sqlite:///C:/path/to/sketchassist.db
# STORAGE_DIR=
# MAX_UPLOAD_MB=5

# ---- AI sketch engines (all optional) -----------------------------------------------------------------------------
# Without any of these the app still works: the rule-based "schematic" engine needs nothing, and the AI
# engines clearly report "setup required". See docs/MODEL_SELECTION.md.
AI_PROVIDER=auto                    # auto | none | huggingface | openai | diffusers
AI_TIMEOUT_SECONDS=180

# Hugging Face Inference Providers (default models are Apache-2.0)
HF_TOKEN=
HF_PROVIDER=auto
HF_T2I_MODEL=Qwen/Qwen-Image
HF_EDIT_MODEL=Qwen/Qwen-Image-Edit

# OpenAI Images API (or a compatible endpoint). Model names change - check OpenAI's documentation.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_IMAGE_MODEL=gpt-image-2.5-sunburst
OPENAI_IMAGE_QUALITY=medium

# Local diffusers (experimental; needs a big GPU and requirements-ai-local.txt)
LOCAL_T2I_MODEL=black-forest-labs/FLUX.1-schnell
LOCAL_EDIT_MODEL=Qwen/Qwen-Image-Edit
LOCAL_DEVICE=auto
LOCAL_STEPS=4
